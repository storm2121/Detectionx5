# Normalise line endings in the repository and check text out with LF on every platform,
# as .editorconfig, Prettier and ruff expect (a native CRLF checkout fails Prettier's check).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF even on Windows checkouts (they run inside containers).
*.sh text eol=lf

# Never munge binary assets. Models stay under 15 MB each (AGENT_RULES §4.4).
*.pt binary
*.pth binary
*.onnx binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.bmp binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated files: collapse them in diffs.
uv.lock linguist-generated=true -diff
requirements.txt linguist-generated=true
requirements-dev.txt linguist-generated=true
