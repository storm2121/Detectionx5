{
  "name": "detectionx5-dashboard",
  "private": true,
  "version": "2.0.0-dev",
  "description": "The DetectionX5 console: reads, jobs, review, evaluation, models and methods.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "vue-tsc --build && vite build && node scripts/check-bundle.mjs",
    "bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "prestorybook": "node scripts/sync-assets.mjs",
    "storybook": "storybook dev --port 6106",
    "prestorybook:build": "node scripts/sync-assets.mjs",
    "storybook:build": "storybook build --output-dir storybook-static --quiet",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.50.0",
    "d3": "7.9.0",
    "katex": "0.16.47",
    "motion": "13.5.1",
    "onnxruntime-web": "1.22.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.53.2",
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/vue3": "8.6.19",
    "@storybook/vue3-vite": "8.6.19",
    "@types/d3": "7.4.3",
    "@types/katex": "0.16.7",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.2.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "storybook": "8.6.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.3.7",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.1.4",
    "vue-tsc": "2.2.12"
  }
}
