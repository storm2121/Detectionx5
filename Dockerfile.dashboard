# The Vue console: built with Node and pnpm, served by nginx, which forwards /api to the
# plate service (Compose service `api`). The build reads the plate fonts from the synthetic
# generator, the committed results (for the tests and stories it type-checks) and the
# synthetic sample scenes from the parity fixtures.
FROM node:22.17.0-alpine AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo/apps/dashboard
COPY apps/dashboard/package.json apps/dashboard/pnpm-lock.yaml apps/dashboard/.npmrc ./
RUN pnpm install --frozen-lockfile
COPY apps/dashboard ./
COPY plate_reader/synthetic/fonts /repo/plate_reader/synthetic/fonts
COPY results/*.json /repo/results/
COPY tests/fixtures/parity /repo/tests/fixtures/parity
RUN pnpm build

FROM nginx:1.27-alpine
COPY docker/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
