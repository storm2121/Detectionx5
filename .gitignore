# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local secrets and settings
.env
.env.local

# Pipeline output
output/
runs/
crops/
*.log

# Real data is a placeholder until the final step (AGENT_RULES §1.1): only the README,
# detector.yaml and the empty layout are tracked.
data/**
!data/**/
!data/README.md
!data/detector.yaml
!data/**/.gitkeep

# Synthetic sets are regenerated deterministically from a seed, never committed.
synthetic/

# HTML reports are regenerated; the JSON next to them is the committed source of truth.
results/*.html
results/**/*.html

# Model weights are large; only the committed models in models/ are tracked.
# Upstream YOLO checkpoints downloaded during training or export are not.
yolov*.pt
yolo*.onnx
!models/best.pt
models/checkpoints/

# The upstream YOLOv10 source tree, if cloned here for training.
yolov10/

# PyInstaller
*.spec
*.manifest

# Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Node (dashboard)
node_modules/
apps/dashboard/dist/
apps/dashboard/storybook-static/
apps/dashboard/test-results/
apps/dashboard/playwright-report/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
